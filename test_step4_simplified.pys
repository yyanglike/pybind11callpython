def build_dataframe(n):
    idx = [i for i in range(n)]
    print(idx)
    squares = [i * i for i in idx]
    cubes = [i * i * i for i in idx]

    # 使用列表
    arr_idx = list(idx)
    arr_sq = list(squares)
    arr_cb = list(cubes)

    # 用 dict 合并数据
    data = {"x": arr_idx, "x2": arr_sq}
    # 模拟DataFrame
    df = {"data": data, "shape": (len(arr_idx), 2)}
    df2 = df  # alias

    # 给 df2 增加一列 x3
    df2["x3"] = arr_cb

    # 创建一个分组列（偶数/奇数）
    df2["cat"] = ["even" if i % 2 == 0 else "odd" for i in arr_idx]

    return df2

try:
    df = build_dataframe(5)
    print("DataFrame created successfully")
    print("DataFrame shape:", df["shape"])
    print("DataFrame columns:", list(df["data"].keys()))
    print("First few rows:")
    for i in range(min(5, len(df["data"]["x"]))):
        print(f"  x={df['data']['x'][i]}, x2={df['data']['x2'][i]}, x3={df['x3'][i]}, cat={df['cat'][i]}")
except Exception as e:
    print("ERROR in build_dataframe:", e)
