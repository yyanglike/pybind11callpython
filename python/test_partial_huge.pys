import json as json
print("Step 1: json imported")

def range_list(n):
    return list(range(n))
print("Step 2: range_list defined")

def compute_stats(nums):
    import numpy as np
    mean = np.mean(nums)
    std = np.std(nums)
    return { "mean": mean, "std": std, "count": len(nums) }
print("Step 3: compute_stats defined")

def build_dataframe(n):
    import numpy as np
    import pandas as pd
    idx = [i for i in range_list(n)]
    squares = [i * i for i in idx]
    cubes = [i * i * i for i in idx]

    arr_idx = np.array(idx)
    arr_sq = np.array(squares)
    arr_cb = np.array(cubes)

    data = {"x": arr_idx, "x2": arr_sq}
    df = pd.DataFrame(data)
    df2 = df

    df2["x3"] = arr_cb
    df2["cat"] = ["even" if i % 2 == 0 else "odd" for i in arr_idx]

    return df2
print("Step 4: build_dataframe defined")

def main():
    import sys
    args = sys.argv
    print("args:", args)
    n = 50
    if len(args) > 1:
        n = int(args[1])
    print("n:", n)
    print("Building dataframe...")
    df = build_dataframe(n)
    print("DataFrame built")
    grouped = df.groupby("cat")
    print("Grouped")
    agg = grouped.agg({ "x": "sum", "x3": "mean" })
    print("Aggregated")
    summary = agg.to_dict()
    extra = { "meta": { "n": n, "source": "huge_complex_program.pys" } }
    print("Summary and extra created")
    merged = { **summary, **extra }
    print("Merged")
    print(json.dumps(merged, indent=2))
    return merged

print("Step 5: main defined, calling main()")
result = main()
print("Result:", result)
print("Step 6: all done")
