# 测试 elif 关键字

x = 5

if x < 0:
    result = "negative"
elif x == 0:
    result = "zero"
elif x < 10:
    result = "small"
else:
    result = "large"

print("x =", x, ", result =", result)

# 测试多个elif
score = 85

if score >= 90:
    grade = "A"
elif score >= 80:
    grade = "B"
elif score >= 70:
    grade = "C"
elif score >= 60:
    grade = "D"
else:
    grade = "F"

print("score =", score, ", grade =", grade)

