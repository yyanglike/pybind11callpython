# 测试位运算符和//运算符

# 测试 //
result1 = 10 // 3
print("10 // 3 =", result1)

result2 = 10.5 // 3.2
print("10.5 // 3.2 =", result2)

# 测试 &
result3 = 5 & 3
print("5 & 3 =", result3)

# 测试 |
result4 = 5 | 3
print("5 | 3 =", result4)

# 测试 ^
result5 = 5 ^ 3
print("5 ^ 3 =", result5)

# 测试 <<
result6 = 5 << 2
print("5 << 2 =", result6)

# 测试 >>
result7 = 20 >> 2
print("20 >> 2 =", result7)

# 测试 ~
result8 = ~5
print("~5 =", result8)

# 测试组合
result9 = (5 & 3) | (10 << 1)
print("(5 & 3) | (10 << 1) =", result9)

