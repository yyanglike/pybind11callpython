#!/usr/bin/env python3
"""
测试 del 操作的正确性
"""

print("测试 del 操作")

# 测试1: 删除列表元素
my_list = [1, 2, 3, 4, 5]
print(f"Before del: my_list={my_list}")
del my_list[1]
print(f"After del my_list[1]: my_list={my_list}")
assert my_list == [1, 3, 4, 5], f"Expected [1, 3, 4, 5], got {my_list}"

# 测试2: 删除字典键
my_dict = {"a": 1, "b": 2, "c": 3}
print(f"Before del: my_dict={my_dict}")
del my_dict["b"]
print(f"After del my_dict['b']: my_dict={my_dict}")
assert my_dict == {"a": 1, "c": 3}, f"Expected {{'a': 1, 'c': 3}}, got {my_dict}"

# 测试3: 删除变量
x = 10
print(f"Before del: x={x}")
del x
try:
    print(f"After del: x={x}")
    assert False, "x should not exist after del"
except NameError:
    print("x correctly deleted (NameError raised)")

print("所有 del 测试通过！")

