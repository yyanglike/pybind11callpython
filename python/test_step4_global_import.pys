print("Testing step4: build_dataframe")
import numpy as np
import pandas as pd

def build_dataframe(n):
    import pandas as pd
    idx = [i for i in range(n)]
    print(idx)
    squares = [i * i for i in idx]
    cubes = [i * i * i for i in idx]

    # 直接使用列表构造DataFrame，避免标量值触发index错误
    data = {
        "x": idx,
        "x2": squares,
        "x3": cubes,
        "cat": ["even" if i % 2 == 0 else "odd" for i in idx],
    }
    df = pd.DataFrame(data)
    return df

try:
    df = build_dataframe(5)
    print("DataFrame created successfully")
    print("DataFrame shape:", df.shape)
    print("DataFrame columns:", list(df.columns))
    print("First few rows:")
    print(df.head())
except Exception as e:
    print("ERROR in build_dataframe:", e)
