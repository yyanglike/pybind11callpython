# 测试赋值运算符

# 测试 +=
x = 10
x += 5
print("x += 5, x =", x)

# 测试 -=
y = 20
y -= 8
print("y -= 8, y =", y)

# 测试 *=
z = 3
z *= 4
print("z *= 4, z =", z)

# 测试 /=
a = 20
a /= 4
print("a /= 4, a =", a)

# 测试 //=
b = 20
b //= 3
print("b //= 3, b =", b)

# 测试 %=
c = 20
c %= 7
print("c %= 7, c =", c)

# 测试 **=
d = 2
d **= 3
print("d **= 3, d =", d)

# 测试 &=
e = 15
e &= 7
print("e &= 7, e =", e)

# 测试 |=
f = 5
f |= 3
print("f |= 3, f =", f)

# 测试 ^=
g = 5
g ^= 3
print("g ^= 3, g =", g)

# 测试 <<=
h = 5
h <<= 2
print("h <<= 2, h =", h)

# 测试 >>=
i = 20
i >>= 2
print("i >>= 2, i =", i)

