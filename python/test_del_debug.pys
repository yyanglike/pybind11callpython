#!/usr/bin/env python3
"""
详细测试 del 操作
"""

print("测试 del 操作 - 详细版本")

# 测试1: 删除列表元素并立即检查
my_list = [1, 2, 3, 4, 5]
print(f"Step 1: my_list={my_list}, type={type(my_list)}")
del my_list[1]
print(f"Step 2: After del my_list[1], my_list={my_list}, type={type(my_list)}")
if my_list is None:
    print("ERROR: my_list is None!")
else:
    print(f"Step 3: my_list content: {my_list}")
    print(f"Step 4: len(my_list)={len(my_list)}")

# 测试2: 删除字典键并立即检查
my_dict = {"a": 1, "b": 2, "c": 3}
print(f"\nStep 1: my_dict={my_dict}, type={type(my_dict)}")
del my_dict["b"]
print(f"Step 2: After del my_dict['b'], my_dict={my_dict}, type={type(my_dict)}")
if my_dict is None:
    print("ERROR: my_dict is None!")
else:
    print(f"Step 3: my_dict content: {my_dict}")
    print(f"Step 4: len(my_dict)={len(my_dict)}")

print("\n测试完成")

