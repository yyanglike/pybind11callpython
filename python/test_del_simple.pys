#!/usr/bin/env python3
"""
简单测试 del 操作
"""

my_list = [1, 2, 3]
print(f"1. my_list={my_list}")

del my_list[0]
print(f"2. After del my_list[0], my_list={my_list}")

# 直接访问变量
print(f"3. Direct access: my_list={my_list}")

# 检查变量是否存在
if my_list is not None:
    print(f"4. my_list exists: {my_list}")
else:
    print("4. ERROR: my_list is None!")

