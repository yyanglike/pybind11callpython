print("\n[9] 异步编程测试")

async def async_function(n: int):
    """异步函数"""
    return n * 2

async def async_generator(n: int):
    """异步生成器"""
    for i in range(n):
        yield i * 2

# 注意：异步代码需要事件循环，这里主要测试语法
print("✓ 异步编程语法测试通过（需要事件循环执行）")

# ============================================================================
# 第十部分：装饰器（脚本级别应用）
# ============================================================================
print("\n[10] 装饰器测试")

def timing_decorator(func):
    """计时装饰器"""
    def wrapper(*args, **kwargs):
        result = func(*args, **kwargs)
        return result
    return wrapper

def cache_decorator(func):
    """缓存装饰器"""
    cache = {}
    def wrapper(*args, **kwargs):
        key = str(args) + str(kwargs)
        if key not in cache:
            cache[key] = func(*args, **kwargs)
        return cache[key]
    return wrapper

@timing_decorator
@cache_decorator
def decorated_function(n: int):
    """被装饰的函数"""
    return n * n * n

# 脚本级别调用装饰器函数
decorated_result = decorated_function(5)
print(f"✓ 装饰器: result={decorated_result}")

# ============================================================================
# 第十一部分：上下文管理器（脚本级别）
# ============================================================================
print("\n[11] 上下文管理器测试（脚本级别）")

class ResourceManager:
    """资源管理器"""
    def __init__(self, name: str):
        self.name = name
        self.opened = False
    
    def __enter__(self):
        self.opened = True
        return self
    
    def __exit__(self, exc_type, exc_val, exc_tb):
        self.opened = False
        return False

# 脚本级别使用 with 语句
with ResourceManager("test") as rm:
    assert rm.opened == True, "上下文管理器测试失败"
    print(f"✓ 上下文管理器: {rm.name}, opened={rm.opened}")

assert rm.opened == False, "上下文管理器退出测试失败"

