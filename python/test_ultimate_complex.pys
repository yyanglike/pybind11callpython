# 列表推导式（嵌套）
list_comp = [
    x * y 
    for x in range(1, 4) 
    for y in range(1, 4) 
    if x * y % 2 == 0
]
print(f"✓ 列表推导式（嵌套）: {list_comp}")

# 字典推导式（嵌套）
dict_comp = {
    f"{x}_{y}": x * y
    for x in range(1, 4)
    for y in range(1, 4)
