# ============================================================================
print("\n[16] 脚本级别复杂组合操作")

# 直接在脚本中组合多种操作
combined_results = []

for i in range(10):
    # 条件表达式 + Walrus 运算符
    if (value := i * 2) > 10:
        # 列表推导式 + 条件
        filtered = [x for x in range(value) if x % 2 == 0]
        # 字典推导式
        mapped = {f"key_{x}": x * 2 for x in filtered[:5]}
        # 集合操作
        unique = set(mapped.values())
        combined_results.append({
            "value": value,
            "filtered_count": len(filtered),
            "mapped": mapped,
            "unique_count": len(unique)
        })

print(f"✓ 复杂组合操作: {len(combined_results)} 个结果")

