}
print(f"✓ 字典推导式（嵌套）: {len(dict_comp)} 个元素")

# 集合推导式（嵌套）
set_comp = {
    x * y
    for x in range(1, 4)
    for y in range(1, 4)
    if x * y > 2
}
print(f"✓ 集合推导式（嵌套）: {set_comp}")

# 生成器表达式 - 使用函数包装避免语法问题
def make_gen():
    for x in range(10):
        if x % 2 == 0:
            yield x * x  # 使用乘法代替 ** 运算符
gen = make_gen()
generator_result = list(gen)
print(f"✓ 生成器表达式: {generator_result}")

# 复杂嵌套推导式
matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
