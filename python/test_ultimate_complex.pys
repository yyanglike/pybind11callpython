# 第六部分：生成器和 yield（需要函数，但测试脚本级别的调用）
# ============================================================================
print("\n[6] 生成器和 yield 测试")

def fibonacci_generator(n: int):
    """斐波那契生成器"""
    a, b = 0, 1
    for _ in range(n):
        yield a
        a, b = b, a + b

def generator_with_yield_from():
    """使用 yield from 的生成器"""
    yield from range(5)
    yield from fibonacci_generator(5)
    yield from [100, 200, 300]

# 脚本级别调用生成器
gen1 = fibonacci_generator(10)
fib_nums = list(gen1)
print(f"✓ 生成器: fib前5个={fib_nums[:5]}")

gen2 = generator_with_yield_from()
yield_from_results = list(gen2)
print(f"✓ yield from: 前5个={yield_from_results[:5]}")

