# reduce 在脚本级别
from functools import reduce
product = reduce(lambda x, y: x * y, numbers)
print(f"✓ reduce: {product}")

# 高阶函数在脚本级别
def apply_twice(func, value):
    return func(func(value))

double_twice = apply_twice(lambda x: x * 2, 5)
print(f"✓ 高阶函数: {double_twice}")

