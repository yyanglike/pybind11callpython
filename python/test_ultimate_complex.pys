print("\n[14] 类和继承测试（脚本级别）")

class BaseClass:
    """基类"""
    def __init__(self, name: str):
        self.name = name
        self._protected = "protected"
        self.__private = "private"
    
    def base_method(self):
        return f"Base: {self.name}"
    
    def overridden_method(self):
        return "Base implementation"

class DerivedClass(BaseClass):
    """派生类"""
    def __init__(self, name: str, extra: str):
        super().__init__(name)
        self.extra = extra
    
    def overridden_method(self):
        return f"Derived: {self.name}, extra: {self.extra}"
    
    def new_method(self):
        return f"New method: {self.extra}"

# 脚本级别创建和使用对象
obj = DerivedClass("test", "extra_value")
base_result = obj.base_method()
override_result = obj.overridden_method()
new_result = obj.new_method()
print(f"✓ 类和继承: base={base_result}, override={override_result}, new={new_result}")

