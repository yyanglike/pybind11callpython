def deco_tag(cls):
    cls.tag = "decorated"
    return cls

def deco_count(cls):
    cls.calls = 0
    orig_init = getattr(cls, "__init__", None)
    def __init__(self, *args, **kwargs):
        cls.calls += 1
        if orig_init:
            orig_init(self, *args, **kwargs)
    cls.__init__ = __init__
    return cls

def make_deco_base_val(val):
    def deco(cls):
        cls.base_val = val
        return cls
    return deco

base_val = 10

@deco_tag
@deco_count
@make_deco_base_val(10)
class Base:
    def foo(self):
        return self.base_val

class Child(Base,):
    def foo(self):
        return super().foo() + 1

c = Child()
print("inherit_tag", getattr(c, "tag", None), getattr(Base, "calls", None), c.foo())


