#!/usr/bin/env python3
"""
破坏性测试 - 边界情况、异常输入、错误恢复

测试内容：
1. 边界值测试（最大值、最小值、零值、负数）
2. 异常输入测试（None、空值、错误类型）
3. 错误恢复测试（异常处理、资源清理）
4. 极端场景测试（超大值、深度嵌套、无限递归防护）
5. 类型错误测试
6. 索引越界测试
7. 键不存在测试
8. 除零错误测试
9. 内存溢出防护
10. 栈溢出防护
"""

import sys

print("=" * 80)
print("破坏性测试 - 边界情况和异常输入")
print("=" * 80)

# ============================================================================
# 测试1：边界值测试（脚本级别）
# ============================================================================
print("\n[1] 边界值测试（脚本级别）")

# 直接在脚本顶层测试边界值
boundary_results = []

# 零值
try:
    result = 0 / 1
    boundary_results.append(("zero_division", "ok", result))
except Exception as e:
    boundary_results.append(("zero_division", "error", str(e)))

# 负数
try:
    result = -100 * -1
    boundary_results.append(("negative", "ok", result))
except Exception as e:
    boundary_results.append(("negative", "error", str(e)))

# 大整数
try:
    large = 10 ** 100
    result = large + 1
    boundary_results.append(("large_int", "ok", "success"))
except Exception as e:
    boundary_results.append(("large_int", "error", str(e)))

# 空列表
try:
    empty_list = []
    result = len(empty_list)
    boundary_results.append(("empty_list", "ok", result))
except Exception as e:
    boundary_results.append(("empty_list", "error", str(e)))

# 空字典
try:
    empty_dict = {}
    result = len(empty_dict)
    boundary_results.append(("empty_dict", "ok", result))
except Exception as e:
    boundary_results.append(("empty_dict", "error", str(e)))

print(f"✓ 边界值测试完成: {len(boundary_results)} 个测试")

# ============================================================================
# 测试2：异常输入测试（脚本级别）
# ============================================================================
print("\n[2] 异常输入测试（脚本级别）")

# 直接在脚本顶层测试异常输入
exceptional_results = []

# None 值
try:
    x = None
    if x is None:
        exceptional_results.append(("none_check", "ok", "handled"))
    else:
        exceptional_results.append(("none_check", "error", "not_handled"))
except Exception as e:
    exceptional_results.append(("none_check", "error", str(e)))

# 类型错误
try:
    result = "string" + 123  # 应该失败
    exceptional_results.append(("type_error", "unexpected", result))
except TypeError as e:
    exceptional_results.append(("type_error", "ok", "caught"))
except Exception as e:
    exceptional_results.append(("type_error", "other_error", str(e)))

# 空字符串
try:
    empty_str = ""
    result = len(empty_str)
    exceptional_results.append(("empty_string", "ok", result))
except Exception as e:
    exceptional_results.append(("empty_string", "error", str(e)))

print(f"✓ 异常输入测试完成: {len(exceptional_results)} 个测试")

# ============================================================================
# 测试3：索引越界测试（脚本级别）
# ============================================================================
print("\n[3] 索引越界测试（脚本级别）")

# 直接在脚本顶层测试索引越界
index_results = []

# 列表索引越界
try:
    my_list = [1, 2, 3]
    result = my_list[10]  # 应该失败
    index_results.append(("list_index", "unexpected", result))
except IndexError as e:
    index_results.append(("list_index", "ok", "caught"))
except Exception as e:
    index_results.append(("list_index", "other_error", str(e)))

# 负数索引（应该正常）
try:
    my_list = [1, 2, 3]
    result = my_list[-1]
    assert result == 3, "负数索引失败"
    index_results.append(("negative_index", "ok", result))
except Exception as e:
    index_results.append(("negative_index", "error", str(e)))

# 字符串索引
try:
    my_str = "hello"
    result = my_str[10]  # 应该失败
    index_results.append(("string_index", "unexpected", result))
except IndexError as e:
    index_results.append(("string_index", "ok", "caught"))
except Exception as e:
    index_results.append(("string_index", "other_error", str(e)))

print(f"✓ 索引越界测试完成: {len(index_results)} 个测试")

# ============================================================================
# 测试4：键不存在测试（脚本级别）
# ============================================================================
print("\n[4] 键不存在测试（脚本级别）")

# 直接在脚本顶层测试键不存在
key_results = []

# 字典键不存在
try:
    my_dict = {"a": 1, "b": 2}
    result = my_dict["c"]  # 应该失败
    key_results.append(("dict_key", "unexpected", result))
except KeyError as e:
    key_results.append(("dict_key", "ok", "caught"))
except Exception as e:
    key_results.append(("dict_key", "other_error", str(e)))

# 使用 get 方法（应该安全）
try:
    my_dict = {"a": 1, "b": 2}
    result = my_dict.get("c", "default")
    assert result == "default", "get 方法失败"
    key_results.append(("dict_get", "ok", result))
except Exception as e:
    key_results.append(("dict_get", "error", str(e)))

# del 不存在的键
try:
    my_dict = {"a": 1}
    del my_dict["b"]  # 应该失败
    key_results.append(("del_key", "unexpected", "not_failed"))
except KeyError as e:
    key_results.append(("del_key", "ok", "caught"))
except Exception as e:
    key_results.append(("del_key", "other_error", str(e)))

print(f"✓ 键不存在测试完成: {len(key_results)} 个测试")

# ============================================================================
# 测试5：除零错误测试（脚本级别）
# ============================================================================
print("\n[5] 除零错误测试（脚本级别）")

# 直接在脚本顶层测试除零错误
div_zero_results = []

# 整数除零
try:
    result = 10 / 0  # 应该失败
    div_zero_results.append(("int_div_zero", "unexpected", result))
except ZeroDivisionError as e:
    div_zero_results.append(("int_div_zero", "ok", "caught"))
except Exception as e:
    div_zero_results.append(("int_div_zero", "other_error", str(e)))

# 浮点数除零
try:
    result = 10.0 / 0.0  # 应该失败
    div_zero_results.append(("float_div_zero", "unexpected", result))
except ZeroDivisionError as e:
    div_zero_results.append(("float_div_zero", "ok", "caught"))
except Exception as e:
    div_zero_results.append(("float_div_zero", "other_error", str(e)))

# 取模除零
try:
    result = 10 % 0  # 应该失败
    div_zero_results.append(("mod_zero", "unexpected", result))
except ZeroDivisionError as e:
    div_zero_results.append(("mod_zero", "ok", "caught"))
except Exception as e:
    div_zero_results.append(("mod_zero", "other_error", str(e)))

# 整除除零
try:
    result = 10 // 0  # 应该失败
    div_zero_results.append(("floor_div_zero", "unexpected", result))
except ZeroDivisionError as e:
    div_zero_results.append(("floor_div_zero", "ok", "caught"))
except Exception as e:
    div_zero_results.append(("floor_div_zero", "other_error", str(e)))

print(f"✓ 除零错误测试完成: {len(div_zero_results)} 个测试")

# ============================================================================
# 测试6：属性错误测试
# ============================================================================
print("\n[6] 属性错误测试")

def test_attribute_errors():
    """测试属性错误"""
    results = []
    
    # 对象属性不存在
    try:
        class TestClass:
            def __init__(self):
                self.existing = "value"
        
        obj = TestClass()
        result = obj.nonexistent  # 应该失败
        results.append(("attr_error", "unexpected", result))
    except AttributeError as e:
        results.append(("attr_error", "ok", "caught"))
    except Exception as e:
        results.append(("attr_error", "other_error", str(e)))
    
    # del 不存在的属性
    try:
        obj = TestClass()
        del obj.nonexistent  # 应该失败
        results.append(("del_attr", "unexpected", "not_failed"))
    except AttributeError as e:
        results.append(("del_attr", "ok", "caught"))
    except Exception as e:
        results.append(("del_attr", "other_error", str(e)))
    
    return results

attr_results = test_attribute_errors()
print(f"✓ 属性错误测试完成: {len(attr_results)} 个测试")

# ============================================================================
# 测试7：递归深度限制测试
# ============================================================================
print("\n[7] 递归深度限制测试")

def recursive_function(depth: int, max_depth: int = 100):
    """递归函数（带深度限制）"""
    if depth > max_depth - 1:  # 使用 > 而不是 >= 避免 >= 运算符问题
        return depth
    return recursive_function(depth + 1, max_depth)

try:
    # 正常递归
    result1 = recursive_function(0, 50)
    assert result1 == 50, "正常递归失败"
    print("  ✓ 正常递归测试通过")
    
    # 深度递归（应该能处理）
    result2 = recursive_function(0, 200)
    assert result2 == 200, "深度递归失败"
    print("  ✓ 深度递归测试通过")
except RecursionError as e:
    print(f"  ⚠ 递归深度限制: {e}")
except Exception as e:
    print(f"  ✗ 递归测试失败: {e}")

# ============================================================================
# 测试8：超大数据结构测试
# ============================================================================
print("\n[8] 超大数据结构测试")

def test_large_data_structures():
    """测试超大数据结构"""
    results = []
    
    # 大列表
    try:
        large_list = [i for i in range(10000)]
        result = len(large_list)
        assert result == 10000, "大列表测试失败"
        results.append(("large_list", "ok", result))
    except Exception as e:
        results.append(("large_list", "error", str(e)))
    
    # 大字典
    try:
        large_dict = {f"key_{i}": i * 2 for i in range(10000)}
        result = len(large_dict)
        assert result == 10000, "大字典测试失败"
        results.append(("large_dict", "ok", result))
    except Exception as e:
        results.append(("large_dict", "error", str(e)))
    
    # 大集合
    try:
        large_set = {i for i in range(10000)}
        result = len(large_set)
        assert result == 10000, "大集合测试失败"
        results.append(("large_set", "ok", result))
    except Exception as e:
        results.append(("large_set", "error", str(e)))
    
    return results

large_ds_results = test_large_data_structures()
print(f"✓ 超大数据结构测试完成: {len(large_ds_results)} 个测试")

# ============================================================================
# 测试9：嵌套深度测试
# ============================================================================
print("\n[9] 嵌套深度测试")

def test_nested_depth():
    """测试嵌套深度"""
    # 深度嵌套列表
    nested_list = [[[[[i for i in range(10)] for _ in range(5)] for _ in range(3)] for _ in range(2)] for _ in range(2)]
    assert len(nested_list) == 2, "嵌套列表测试失败"
    print("  ✓ 深度嵌套列表测试通过")
    
    # 深度嵌套字典
    nested_dict = {
        "level1": {
            "level2": {
                "level3": {
                    "level4": {
                        "level5": "value"
                    }
                }
            }
        }
    }
    assert nested_dict["level1"]["level2"]["level3"]["level4"]["level5"] == "value", "嵌套字典测试失败"
    print("  ✓ 深度嵌套字典测试通过")

test_nested_depth()

# ============================================================================
# 测试10：错误恢复测试（脚本级别）
# ============================================================================
print("\n[10] 错误恢复测试（脚本级别）")

# 直接在脚本顶层测试错误恢复
recovery_results = []
success_count = 0

for i in range(100):
    try:
        # 随机操作，可能出错
        if i % 10 == 0:
            raise ValueError(f"Error at {i}")
        success_count += 1
    except ValueError:
        # 恢复：继续执行
        pass
    except Exception as e:
        # 其他错误也恢复
        pass

recovery_rate = success_count / 100 * 100 if 100 > 0 else 0
recovery_results.append(("recovery_rate", recovery_rate))

print(f"✓ 错误恢复测试完成: 恢复率={recovery_rate:.1f}%")

# ============================================================================
# 测试11：类型转换错误测试
# ============================================================================
print("\n[11] 类型转换错误测试")

def test_type_conversion_errors():
    """测试类型转换错误"""
    results = []
    
    # 字符串转整数（无效）
    try:
        result = int("not_a_number")  # 应该失败
        results.append(("str_to_int", "unexpected", result))
    except ValueError as e:
        results.append(("str_to_int", "ok", "caught"))
    except Exception as e:
        results.append(("str_to_int", "other_error", str(e)))
    
    # 字符串转浮点数（无效）
    try:
        result = float("not_a_float")  # 应该失败
        results.append(("str_to_float", "unexpected", result))
    except ValueError as e:
        results.append(("str_to_float", "ok", "caught"))
    except Exception as e:
        results.append(("str_to_float", "other_error", str(e)))
    
    return results

type_conv_results = test_type_conversion_errors()
print(f"✓ 类型转换错误测试完成: {len(type_conv_results)} 个测试")

# ============================================================================
# 测试12：空值操作测试
# ============================================================================
print("\n[12] 空值操作测试")

def test_none_operations():
    """测试 None 值操作"""
    results = []
    
    # None 检查
    try:
        x = None
        if x is None:
            results.append(("none_check", "ok", "handled"))
        else:
            results.append(("none_check", "error", "not_handled"))
    except Exception as e:
        results.append(("none_check", "error", str(e)))
    
    # None 属性访问
    try:
        x = None
        result = x.attribute  # 应该失败
        results.append(("none_attr", "unexpected", result))
    except AttributeError as e:
        results.append(("none_attr", "ok", "caught"))
    except Exception as e:
        results.append(("none_attr", "other_error", str(e)))
    
    # None 索引访问
    try:
        x = None
        result = x[0]  # 应该失败
        results.append(("none_index", "unexpected", result))
    except TypeError as e:
        results.append(("none_index", "ok", "caught"))
    except Exception as e:
        results.append(("none_index", "other_error", str(e)))
    
    return results

none_results = test_none_operations()
print(f"✓ 空值操作测试完成: {len(none_results)} 个测试")

