#!/usr/bin/env python3
"""
压力测试 - 大量数据、深度嵌套、复杂计算

测试内容：
1. 大量数据处理（百万级数据）
2. 深度嵌套结构（多层嵌套）
3. 复杂计算（数学运算、字符串处理）
4. 并发压力（大量函数调用）
5. 内存压力（大量对象创建）
6. CPU压力（密集计算）
7. 组合压力（多种压力同时施加）
"""

import time
import random
import sys

print("=" * 80)
print("压力测试 - 大量数据和复杂计算")
print("=" * 80)

# ============================================================================
# 测试1：大量数据处理（脚本级别）
# ============================================================================
print("\n[1] 大量数据处理测试（脚本级别）")

# 直接在脚本顶层处理大量数据
start_time = time.time()
size = 10000  # 减小规模以便快速测试

# 创建大列表
large_list = [i for i in range(size)]

# 列表操作
large_list.extend(range(size, size * 2))
# 使用列表推导式，但避免在条件中使用复杂表达式
filtered_list = []
for x in large_list:
    if x % 2 == 0:
        filtered_list.append(x * 2)
large_list = filtered_list

# 创建大字典
large_dict = {f"key_{i}": i * 2 for i in range(size)}

# 字典操作
for i in range(size, size * 2):
    large_dict[f"key_{i}"] = i * 2

# 创建大集合
large_set = {i for i in range(size)}
large_set.update(range(size, size * 2))

elapsed_time = time.time() - start_time

list_size = len(large_list)
dict_size = len(large_dict)
set_size = len(large_set)

print(f"✓ 大量数据处理完成:")
print(f"    列表大小: {list_size}")
print(f"    字典大小: {dict_size}")
print(f"    集合大小: {set_size}")
print(f"    耗时: {elapsed_time:.2f}s")

# ============================================================================
# 测试2：深度嵌套结构
# ============================================================================
print("\n[2] 深度嵌套结构测试")

def create_nested_structure(depth: int = 5, width: int = 5):
    """创建深度嵌套结构"""
    start_time = time.time()
    
    def create_level(current_depth: int):
        if current_depth == 0:
            return {"value": random.randint(1, 100)}
        
        # 避免在字典推导式中使用 f-string，改用普通字符串拼接
        result = {}
        for _ in range(width):
            key = "level_" + str(current_depth)
            result[key] = create_level(current_depth - 1)
        return result
    
    nested = create_level(depth)
    
    # 访问嵌套值
    def get_nested_value(obj, path):
        if path is None:
            return None
        current = obj
        for key in path:
            if isinstance(current, dict):
                current = current[key]
            else:
                return None
        return current
    
    # 测试访问 - 由于所有键都是相同的（都是 "level_X"），我们选择第一个键递归访问
    if nested and isinstance(nested, dict):
        current = nested
        # 递归访问到最深层
        for _ in range(depth):
            if isinstance(current, dict) and current:
                # 获取第一个值
                first_value = list(current.values())[0]
                current = first_value
            else:
                break
        value = current.get("value") if isinstance(current, dict) else None
    else:
        value = None
    
    elapsed = time.time() - start_time
    
    # 计算理论节点数 - 使用循环代替 ** 运算符
    total_nodes = 1
    for _ in range(depth):
        total_nodes *= width
    
    return {
        "depth": depth,
        "width": width,
        "total_nodes": total_nodes,
        "value": value,
        "elapsed_time": elapsed
    }

print("  创建深度嵌套结构（深度=5, 宽度=5）...")
nested_result = create_nested_structure(5, 5)
print(f"✓ 深度嵌套结构测试完成:")
# 提取字典值，避免在 f-string 中使用字典键访问
nested_depth = nested_result['depth']
nested_width = nested_result['width']
nested_total_nodes = nested_result['total_nodes']
nested_elapsed_time = nested_result['elapsed_time']
print(f"    深度: {nested_depth}")
print(f"    宽度: {nested_width}")
print(f"    理论节点数: {nested_total_nodes}")
print(f"    耗时: {nested_elapsed_time:.2f}s")

# ============================================================================
# 测试3：复杂计算（脚本级别）
# ============================================================================
print("\n[3] 复杂计算测试（脚本级别）")

# 直接在脚本顶层进行复杂计算
start_time = time.time()
iterations = 1000  # 减小规模以便快速测试

results = []

for i in range(iterations):
    # 数学运算 - 使用乘法代替 ** 运算符
    if i > 0:
        value = (i * i + i * 3 + 5) / (i + 1)
    else:
        value = 0
    
    # 三角函数计算
    sin_val = abs(value) % (2 * 3.14159)
    cos_val = abs(value) % (2 * 3.14159)
    
    # 复杂表达式 - 使用 math.sqrt 代替 ** 0.5
    import math
    if value > 0:
        result = math.sqrt(value * sin_val + cos_val)
    else:
        result = 0
    results.append(result)

# 统计
total = sum(results)
avg = total / len(results) if results else 0
max_val = max(results) if results else 0
min_val = min(results) if results else 0

elapsed_time = time.time() - start_time

print(f"✓ 复杂计算测试完成:")
print(f"    迭代次数: {iterations}")
print(f"    总和: {total:.2f}")
print(f"    平均值: {avg:.2f}")
print(f"    最大值: {max_val:.2f}")
print(f"    最小值: {min_val:.2f}")
print(f"    耗时: {elapsed_time:.2f}s")

# ============================================================================
# 测试4：大量函数调用（脚本级别）
# ============================================================================
print("\n[4] 大量函数调用测试（脚本级别）")

def simple_function(x: int):
    """简单函数"""
    return x * 2 + 1

# 直接在脚本顶层进行大量函数调用
start_time = time.time()
count = 10000  # 减小规模以便快速测试

results = []
for i in range(count):
    result = simple_function(i)
    results.append(result)

elapsed_time = time.time() - start_time
calls_per_second = count / elapsed_time if elapsed_time > 0 else 0

print(f"✓ 大量函数调用测试完成:")
print(f"    调用次数: {count}")
print(f"    结果数量: {len(results)}")
print(f"    示例结果: {results[0] if results else None}")
print(f"    耗时: {elapsed_time:.2f}s")
print(f"    每秒调用: {calls_per_second:.0f}")

# ============================================================================
# 测试5：内存压力测试（脚本级别）
# ============================================================================
print("\n[5] 内存压力测试（脚本级别）")

# 直接在脚本顶层进行内存压力测试
start_time = time.time()
object_count = 10000  # 减小规模以便快速测试

objects = []

for i in range(object_count):
    # 创建复杂对象
    obj = {
        "id": i,
        "data": [j for j in range(100)],
        "metadata": {f"key_{j}": j * 2 for j in range(50)},
        "nested": {
            "level1": {
                "level2": {
                    "level3": [k for k in range(20)]
                }
            }
        }
    }
    objects.append(obj)

# 操作对象
total_operations = 0
for obj in objects:
    total_operations += obj["id"]
    total_operations += len(obj["data"])
    total_operations += len(obj["metadata"])

elapsed_time = time.time() - start_time

print(f"✓ 内存压力测试完成:")
print(f"    对象数量: {len(objects)}")
print(f"    总操作数: {total_operations}")
print(f"    耗时: {elapsed_time:.2f}s")

# ============================================================================
# 测试6：CPU压力测试（脚本级别）
# ============================================================================
print("\n[6] CPU压力测试（脚本级别）")

# 直接在脚本顶层进行CPU密集型任务
start_time = time.time()
iterations = 10000  # 减小规模以便快速测试

total = 0

for i in range(iterations):
    # 复杂计算 - 使用乘法代替 ** 运算符
    import math
    value = i * i
    value = value * 3 + 5
    value = value % 1000
    value = math.sqrt(value)
    
    # 字符串处理
    str_val = str(value) * 10
    str_val = str_val[:50]
    
    # 列表操作
    list_val = [x for x in range(100)]
    filtered_list = []
    for x in list_val:
        if x % 2 == 0:
            filtered_list.append(x * 2)
    list_val = filtered_list
    
    total += len(list_val)

elapsed_time = time.time() - start_time
iterations_per_second = iterations / elapsed_time if elapsed_time > 0 else 0

print(f"✓ CPU压力测试完成:")
print(f"    迭代次数: {iterations}")
print(f"    总结果: {total}")
print(f"    耗时: {elapsed_time:.2f}s")
print(f"    每秒迭代: {iterations_per_second:.0f}")

# ============================================================================
# 测试7：组合压力测试
# ============================================================================
print("\n[7] 组合压力测试（多种压力同时施加）")

def combined_stress_test(scale: int = 1000):
    """组合压力测试"""
    start_time = time.time()
    
    # 同时进行多种操作
    results = {
        "lists": [],
        "dicts": [],
        "computations": [],
        "function_calls": []
    }
    
    for i in range(scale):
        # 列表操作
        my_list = [x * 2 for x in range(100)]
        results["lists"].append(len(my_list))
        
        # 字典操作 - 避免在字典推导式中使用 f-string
        my_dict = {}
        for j in range(100):
            key = "key_" + str(j)
            my_dict[key] = j * 2
        results["dicts"].append(len(my_dict))
        
        # 计算
        calc = (i * i + i * 3) / (i + 1) if i > 0 else 0
        results["computations"].append(calc)
        
        # 函数调用
        def helper(x):
            return x * 2 + 1
        func_result = helper(i)
        results["function_calls"].append(func_result)
    
    elapsed = time.time() - start_time
    
    return {
        "scale": scale,
        "lists_processed": len(results["lists"]),
        "dicts_processed": len(results["dicts"]),
        "computations_done": len(results["computations"]),
        "function_calls_made": len(results["function_calls"]),
        "elapsed_time": elapsed
    }

print("  开始组合压力测试（规模=1000）...")
combined_result = combined_stress_test(1000)
print("✓ 组合压力测试完成:")
# 避免在 f-string 中使用字典下标访问
scale_val = combined_result['scale']
lists_val = combined_result['lists_processed']
dicts_val = combined_result['dicts_processed']
computations_val = combined_result['computations_done']
function_calls_val = combined_result['function_calls_made']
elapsed_val = combined_result['elapsed_time']
print(f"    规模: {scale_val}")
print(f"    列表处理: {lists_val}")
print(f"    字典处理: {dicts_val}")
print(f"    计算完成: {computations_val}")
print(f"    函数调用: {function_calls_val}")
print(f"    耗时: {elapsed_val:.2f}s")

# ============================================================================
# 测试8：推导式压力测试（脚本级别）
# ============================================================================
print("\n[8] 推导式压力测试（脚本级别）")

# 直接在脚本顶层进行推导式压力测试
start_time = time.time()
size = 1000  # 减小规模以便快速测试

# 列表推导式
list_comp = []
for x in range(size):
    if x % 2 == 0:
        list_comp.append(x * 2)

# 字典推导式
dict_comp = {f"key_{x}": x * 2 for x in range(size)}

# 集合推导式
set_comp = {x * 2 for x in range(size)}

# 嵌套推导式
nested_comp = []
for x in range(100):
    for y in range(100):
        if (x * y) % 2 == 0:
            nested_comp.append(x * y)

elapsed_time = time.time() - start_time

print(f"✓ 推导式压力测试完成:")
print(f"    规模: {size}")
print(f"    列表大小: {len(list_comp)}")
print(f"    字典大小: {len(dict_comp)}")
print(f"    集合大小: {len(set_comp)}")
print(f"    嵌套大小: {len(nested_comp)}")
print(f"    耗时: {elapsed_time:.2f}s")

# ============================================================================
# 测试9：字符串处理压力测试
# ============================================================================
print("\n[9] 字符串处理压力测试")

def string_stress_test(iterations: int = 10000):
    """字符串处理压力测试"""
    start_time = time.time()
    
    results = []
    
    for i in range(iterations):
        # 字符串拼接
        str1 = f"Value_{i}_"
        str2 = str1 * 10
        str3 = str2[:50]
        
        # 字符串分割和连接
        parts = str3.split("_")
        joined = "_".join(parts)
        
        # 字符串格式化
        formatted = f"Number: {i}, String: {joined[:20]}"
        
        results.append(len(formatted))
    
    total_length = sum(results)
    elapsed = time.time() - start_time
    
    return {
        "iterations": iterations,
        "total_length": total_length,
        "avg_length": total_length / iterations if iterations > 0 else 0,
        "elapsed_time": elapsed
    }

print("  开始字符串处理压力测试（10,000次迭代）...")
string_stress_result = string_stress_test(10000)
print(f"✓ 字符串处理压力测试完成:")
# 提取字典值，避免在 f-string 中使用字典键访问
iterations_val = string_stress_result['iterations']
total_length_val = string_stress_result['total_length']
avg_length_val = string_stress_result['avg_length']
elapsed_time_str_val = string_stress_result['elapsed_time']
print(f"    迭代次数: {iterations_val}")
print(f"    总长度: {total_length_val}")
print(f"    平均长度: {avg_length_val:.2f}")
print(f"    耗时: {elapsed_time_str_val:.2f}s")

# ============================================================================
# 测试10：综合压力测试
# ============================================================================
print("\n[10] 综合压力测试（所有压力同时施加）")

def ultimate_stress_test(scale: int = 1000):
    """终极压力测试"""
    start_time = time.time()
    
    # 创建大量数据
    large_data = {
        "lists": [[i * j for j in range(100)] for i in range(scale)],
        "dicts": [{f"key_{j}": i * j for j in range(100)} for i in range(scale)],
        "sets": [{i * j for j in range(100)} for i in range(scale)]
    }
    
    # 复杂计算
    calculations = [
        (i * i + i * 3 + 5) / (i + 1) if i > 0 else 0
        for i in range(scale)
    ]
    
    # 函数调用
    def compute(x):
        return x * 2 + 1
    
    function_results = [compute(i) for i in range(scale)]
    
    # 推导式
    comprehensions = [
        x * y
        for x in range(100)
        for y in range(100)
        if x * y % 2 == 0
    ]
    
    elapsed = time.time() - start_time
    
    return {
        "scale": scale,
        "lists_count": len(large_data["lists"]),
        "dicts_count": len(large_data["dicts"]),
        "sets_count": len(large_data["sets"]),
        "calculations_count": len(calculations),
        "function_results_count": len(function_results),
        "comprehensions_count": len(comprehensions),
        "elapsed_time": elapsed
    }

print(f"  开始综合压力测试（规模={1000}）...")
ultimate_result = ultimate_stress_test(1000)
print(f"✓ 综合压力测试完成:")
# 提取字典值，避免在 f-string 中使用字典键访问
scale_val = ultimate_result['scale']
lists_count_val = ultimate_result['lists_count']
dicts_count_val = ultimate_result['dicts_count']
sets_count_val = ultimate_result['sets_count']
calculations_count_val = ultimate_result['calculations_count']
function_results_count_val = ultimate_result['function_results_count']
comprehensions_count_val = ultimate_result['comprehensions_count']
elapsed_time_val = ultimate_result['elapsed_time']
print(f"    规模: {scale_val}")
print(f"    列表数量: {lists_count_val}")
print(f"    字典数量: {dicts_count_val}")
print(f"    集合数量: {sets_count_val}")
print(f"    计算数量: {calculations_count_val}")
print(f"    函数结果数量: {function_results_count_val}")
print(f"    推导式数量: {comprehensions_count_val}")
print(f"    耗时: {elapsed_time_val:.2f}s")

# ============================================================================
# 测试总结
