def test2_partial(n):
    import numpy as np
    import pandas as pd
    idx = [i for i in range(n)]
    squares = [i * i for i in idx]
    cubes = [i * i * i for i in idx]

    # 使用 numpy 对列表进行转换
    arr_idx = np.array(idx)
    # arr_sq = np.array(squares)
    # arr_cb = np.array(cubes)

    return arr_idx  #, arr_sq, arr_cb

result = test2_partial(5)
print("test2_partial result:", result)
