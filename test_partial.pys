# ============================================================
# 1. 测试 yield 表达式和生成器函数
# ============================================================
print("\n1. 测试 yield 表达式和生成器函数")

def simple_generator(n):
    """简单的生成器函数"""
    for i in range(n):
        yield i * i


print("Function defined:", "simple_generator" in locals())
print("Variable manager check:")
