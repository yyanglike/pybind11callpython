import json as json
print("DEBUG: json imported")

# 简单生成器函数（提前定义，供 build_dataframe 使用）
def range_list(n):
    print("DEBUG: inside range_list, n =", n)
    return list(range(n))

print("DEBUG: range_list defined")

# 创建一个统计函数，使用numpy计算均值和标准差
def compute_stats(nums):
    print("DEBUG: inside compute_stats")
    import numpy as np
    mean = np.mean(nums)
    std = np.std(nums)
    return { "mean": mean, "std": std, "count": len(nums) }

print("DEBUG: compute_stats defined")

# 生成一个DataFrame，演示 new 与 numpy 合作
def build_dataframe(n):
    print("DEBUG: inside build_dataframe, n =", n)
    import numpy as np
    import pandas as pd
    idx = [i for i in range_list(n)]
    print("DEBUG: idx created, len =", len(idx))
    squares = [i * i for i in idx]
    cubes = [i * i * i for i in idx]

    # 使用 numpy 对列表进行转换
    arr_idx = np.array(idx)
    arr_sq = np.array(squares)
    arr_cb = np.array(cubes)

    # 用 dict 合并数据并实例化 pandas.DataFrame
    data = {"x": arr_idx, "x2": arr_sq}
    df = pd.DataFrame(data)
    df2 = df  # alias

    # 给 df2 增加一列 x3
    df2["x3"] = arr_cb

    # 创建一个分组列（偶数/奇数）
    df2["cat"] = ["even" if i % 2 == 0 else "odd" for i in arr_idx]

    return df2

print("DEBUG: build_dataframe defined")

def main():
    print("DEBUG: inside main")
    import sys

    n = 50

    print("[pys] Building dataframe with n=", n)
    df = build_dataframe(n)

    grouped = df.groupby("cat")
    agg = grouped.agg({ "x": "sum", "x3": "mean" })

    summary = agg.to_dict()
    extra = { "meta": { "n": n, "source": "huge_complex_program.pys" } }
    # 确保summary为dict，否则包装后再展开
    if isinstance(summary, dict):
        pass
    else:
        summary = { "summary": summary }
    merged = { **summary, **extra }

    print(json.dumps(merged, indent=2))
    return merged

print("DEBUG: main defined, about to call main()")
main()
print("DEBUG: after main()")
