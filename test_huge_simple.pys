import json as json
print("DEBUG: json imported", flush=True)

def range_list(n):
    print("DEBUG range_list n=", n)
    return list(range(n))

def build_dataframe(n):
    import numpy as np
    import pandas as pd
    if not n:
        n = 5
    n = int(n)
    idx = [i for i in range_list(n)]
    squares = [i * i for i in idx]
    cubes = [i * i * i for i in idx]

    arr_idx = np.array(idx)
    arr_sq = np.array(squares)
    arr_cb = np.array(cubes)

    data = {"x": arr_idx, "x2": arr_sq}
    df = pd.DataFrame(data)
    df2 = df

    df2["x3"] = arr_cb
    df2["cat"] = ["even" if i % 2 == 0 else "odd" for i in arr_idx]

    return df2

def main():
    import sys
    n = 5
    print("DEBUG main n=", n)

    print("[pys] Building dataframe with n={}".format(n), flush=True)
    df = build_dataframe(n)
    print("DataFrame shape: {}".format(df.shape), flush=True)
    return {"shape": df.shape, "n": n}

result = main()
print("Result: {}".format(result), flush=True)
